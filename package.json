{
  "name": "dsh-pi-catalog-sync",
  "version": "0.1.0",
  "description": "dsh plugin: sync the pi.dev model catalog into llm-pi-ai provider routes through the official settings seam, including mixed-protocol routes such as OpenRouter that in-place sync cannot address.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.mjs",
    "dry-run": "node scripts/dry-run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiawei322/dsh-pi-catalog-sync.git"
  },
  "homepage": "https://github.com/jiawei322/dsh-pi-catalog-sync",
  "bugs": {
    "url": "https://github.com/jiawei322/dsh-pi-catalog-sync/issues"
  },
  "author": "jiawei322",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "pi-ai",
    "pi-dev",
    "model-catalog",
    "openrouter"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
